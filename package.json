{
  "name": "alldesign",
  "private": false,
  "version": "0.0.1",
  "type": "module",
  "description": "AllDesign: editor de design em camadas (Layout, Imagem e Vetor) para o navegador, de código aberto.",
  "scripts": {
    "dev": "vite --port 4760 --host 127.0.0.1",
    "build": "tsc -b && tsc -p tsconfig.node.json && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.node.json",
    "test": "node --experimental-strip-types --no-warnings --test \"src/**/*.test.ts\"",
    "fontes": "node scripts/fontes.mjs",
    "predev": "npm run fontes",
    "prebuild": "npm run fontes"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/fragment-mono": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/raleway": "^5.3.0",
    "fflate": "0.8.2",
    "opentype.js": "^1.3.4",
    "paper": "^0.12.18",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  },
  "license": "MIT",
  "bin": {
    "alldesign": "bin/design"
  },
  "engines": {
    "node": ">=22.6"
  },
  "keywords": [
    "design",
    "editor",
    "canvas",
    "svg",
    "carousel",
    "vector",
    "react",
    "typescript"
  ]
}
